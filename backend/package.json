{
  "name": "proysocial-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "test:entregables": "node scripts/test-entregables-operativos.js",
    "test:notificaciones": "node scripts/test-notificaciones.js",
    "test:avatar": "node scripts/test-avatar.js",
    "test:correos": "node scripts/test-correos.js",
    "emails:process": "node scripts/process-notification-emails.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "dev:setup": "node scripts/dev-setup.js",
    "dev:local": "node --env-file=.env.dev src/index.js",
    "ejemplo:excel": "node scripts/generar-excel-ejemplo.js",
    "evidencias:backfill": "node scripts/backfill-evidencias.js",
    "test:db:setup": "node scripts/test-db-setup.js",
    "test:integration:protegidos": "node --env-file=.env.test --test --test-concurrency=1 test/integration/historicos.integration.test.js test/integration/historicos11.integration.test.js test/integration/historicos12.integration.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1"
  }
}
